+// DEFNS: helper functions for checking legality of interchange
+// :-------------------------------------------------------
+bool isPerfectNest(affine::AffineForOp root) {
+  affine::AffineForOp current = root;
+
+  while (true) {
+    auto ops = current.getBody()->without_terminator();
+    llvm::SmallVector<Operation *, 2> bodyOps;
+    for (Operation &op : ops)
+      bodyOps.push_back(&op);
+
+    // if the body is empty, the chain ends here. it's a perfect (but empty)
+    // nest.
+    if (bodyOps.empty())
+      return true;
+
+    // if there is exactly one operation and it's a loop, keep descending.
+    if (bodyOps.size() == 1) {
+      if (auto next = dyn_cast<affine::AffineForOp>(bodyOps[0])) {
+        current = next;
+        continue;
+      }
+      // if the one op is not a loop (e.g., just a load), it's a perfect leaf.
+      return true;
+    }
+
+    // if there is more than one operation, it can only be "perfect" if
+    // none of those operations are loops (i.e., this is the computation leaf).
+    for (Operation *op : bodyOps) {
+      if (isa<affine::AffineForOp>(op))
+        return false; // found a sibling loop.
+    }
+
+    return true;
+  }
+}
+bool isNonRectangularLoopPERFECTNest(affine::AffineForOp problemRoot) {
+  if (!problemRoot)
+    return false;
+
+  llvm::SmallVector<affine::AffineForOp, 6> loopsFound;
+  // take only the perfectly nested loops starting from this root.
+  affine::getPerfectlyNestedLoops(loopsFound, problemRoot);
+
+  // if there's only one loop, it's rectangular by definition (no inner loops
+  // to depend on it).
+  if (loopsFound.size() < 2)
+    return false;
+
+  // collect induction variables to avoid repeated calls.
+  llvm::SmallVector<Value, 6> ivs;
+  for (auto loop : loopsFound) {
+    ivs.push_back(loop.getInductionVar());
+  }
+
+  // check each loop starting from the first inner loop (index 1).
+  for (size_t i = 1; i < loopsFound.size(); ++i) {
+    auto currentLoop = loopsFound[i];
+
+    // check both lower and upper bounds for any mention of outer induction
+    // variables.
+    auto checkBound = [&](OperandRange operands) {
+      for (Value operand : operands) {
+        for (size_t j = 0; j < i; ++j) {
+          if (operand == ivs[j])
+            return true;
+        }
+      }
+      return false;
+    };
+
+    if (checkBound(currentLoop.getLowerBoundOperands()) ||
+        checkBound(currentLoop.getUpperBoundOperands())) {
+      return true; // found a dependency on an outer loop induction var.
+    }
+  }
+
+  return false;
+}
+
+bool hasAffineIfInLoopNest(affine::AffineForOp problemLoop) {
+  // returns true if an affine.if is found anywhere under this loop.
+  return problemLoop
+      .walk([&](affine::AffineIfOp) { return WalkResult::interrupt(); })
+      .wasInterrupted();
+}
+
+int getLoopDepth(affine::AffineForOp forOp) {
+  int depth = 0;
+  Operation *parent = forOp->getParentOp();
+  while (parent) {
+    if (isa<affine::AffineForOp>(parent))
+      ++depth;
+    parent = parent->getParentOp();
+  }
+  return depth;
+}
+
+bool isValidPermutationMap(ArrayRef<unsigned> permMap) {
+  SmallVector<unsigned, 6> sortedPerm(permMap.begin(), permMap.end());
+  llvm::sort(sortedPerm);
+  return llvm::all_of(llvm::enumerate(sortedPerm), [](const auto &entry) {
+    return entry.value() == entry.index();
+  });
+}
+
+FailureOr<unsigned> safePermuteLoops(ArrayRef<affine::AffineForOp> loops,
+                                     ArrayRef<unsigned> permMap) {
+  // guard hard preconditions of affine::permuteLoops to avoid assertion.
+  if (loops.size() != permMap.size())
+    return failure();
+  if (!isValidPermutationMap(permMap))
+    return failure();
+
+  return affine::permuteLoops(loops, permMap);
+}
