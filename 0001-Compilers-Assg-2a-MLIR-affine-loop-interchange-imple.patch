+// imperfect root distribution helper
+// :-----------------------------------------------------------
+
+bool distributeImperfectNestIntoSingleChildRoots(
+    affine::AffineForOp root,
+    SmallVectorImpl<affine::AffineForOp> &distributedRoots) {
+
+  SmallVector<Operation *, 8> bodyOps;
+  for (Operation &op : root.getBody()->without_terminator())
+    bodyOps.push_back(&op);
+
+  // only handle imperfect nests whose body consists solely of sibling
+  // affine.for operations.
+  if (bodyOps.size() < 2)
+    return false;
+  if (!llvm::all_of(bodyOps,
+                    [](Operation *op) { return isa<affine::AffineForOp>(op); }))
+    return false;
+
+  auto keepOnlyNthBodyOp = [](affine::AffineForOp forOp, unsigned keepIdx) {
+    SmallVector<Operation *, 8> toErase;
+    unsigned idx = 0;
+    for (Operation &op : forOp.getBody()->without_terminator()) {
+      if (idx != keepIdx)
+        toErase.push_back(&op);
+      ++idx;
+    }
+    for (Operation *op : toErase)
+      op->erase();
+  };
+
+  distributedRoots.clear();
+  distributedRoots.push_back(root);
+
+  Operation *insertAfter = root.getOperation();
+  for (unsigned keepIdx = 1; keepIdx < bodyOps.size(); ++keepIdx) {
+    Operation *cloneOp = root->clone();
+    Block::iterator insertPoint(insertAfter);
+    ++insertPoint;
+    root->getBlock()->getOperations().insert(insertPoint, cloneOp);
+    insertAfter = cloneOp;
+
+    auto clonedRoot = cast<affine::AffineForOp>(cloneOp);
+    keepOnlyNthBodyOp(clonedRoot, keepIdx);
+    distributedRoots.push_back(clonedRoot);
+  }
+
+  // keep first child in the original root.
+  keepOnlyNthBodyOp(root, /*keepIdx=*/0);
+  return true;
+}
