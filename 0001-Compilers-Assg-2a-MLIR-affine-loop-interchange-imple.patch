+// info func:
+// to find and print all affine.for loops, their induction variables,
+// bounds, and nesting levels.
+void printSingleAffineForLoop(affine::AffineForOp forOp) {
+
+  // compute nesting depth by counting the number of parent affine.for loops.
+  int depth = 0;
+  Operation *parent = forOp->getParentOp();
+  while (parent) {
+    if (isa<affine::AffineForOp>(parent))
+      depth++;
+    parent = parent->getParentOp();
+  }
+
+  // indentation.
+  for (int i = 0; i < depth; ++i)
+    AFFINE_LOOP_INTERCHANGE_VLOG() << "  ";
+
+  AFFINE_LOOP_INTERCHANGE_VLOG()
+      << "Loop (depth=" << depth
+      << ") "; // << "Loop Induction Var: " << forOp.getInductionVar() << "\n";
+
+  AFFINE_LOOP_INTERCHANGE_VLOG() << "LowerBound=";
+  AFFINE_LOOP_INTERCHANGE_VLOG() << forOp.getLowerBoundMap(); // .dump();
+
+  AFFINE_LOOP_INTERCHANGE_VLOG() << " UpperBound=";
+  AFFINE_LOOP_INTERCHANGE_VLOG() << forOp.getUpperBoundMap(); // .dump();
+
+  AFFINE_LOOP_INTERCHANGE_VLOG() << "\n";
+}
